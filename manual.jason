{
  "reviewer": {
    "Side Menu (Basic)": {
      "Theme Selector": "Switches visual style sheets across light, matte, and high-saturation contrast options globally.",
      "About / Manual": "Displays current application version, git build info, and operational guidelines."
    },
    "Reviewer Panel": {
      "Story Selection": "Selects the active narrative entry that you want to evaluate from live database logs. Choosing a previously reviewed story automatically repopulates all inputs.",
      "Reviewer Name": "Identifies your submitted grading entries securely so that scores compile properly on metrics ledgers.",
      "Rating Input": "Saves your numerical score evaluation (1-10). Rating is single-vote locked and cannot be altered after 18:00 IST for current-day entries, nor changed for previous days' stories.",
      "Guess the Author (Optional)": "Allows you to guess the writer of the current story. Disables dynamically based on moderator time-locks.",
      "Suggest a Title (Optional)": "Allows you to suggest a custom heading. Disables dynamically based on moderator time-locks.",
      "Submit Review": "Dispatches your scores, title choices, and writer speculations directly onto cloud servers."
    },
    "App Feedback Panel": {
      "Feedback Submission Form": "A dedicated text area to route development requests, bugs, or feature ideas directly to the programming teams."
    },
    "Authentication Panel": {
      "Credentials Login": "A secure gateway requiring an authorized Email and Password to unlock Moderator or Developer control panels."
    }
  },
  "moderator": {
    "Side Menu (Moderator Tools)": {
      "Moderator Profile Handle": "Locks an immutable signature identity handle onto the active evaluation sheet summary window layout.",
      "Season Setup": "Commits the active subject text properties and month, automatically generating the season name (e.g. May26), and unlocking advanced tools.",
      "Advanced Locks (Author/Title)": "Toggles that completely hide or show the optional writer/title fields on user forms. Includes manual time-lock inputs to freeze submissions at a specific hour.",
      "Season Summary (Preview/Download)": "Compiles filtered seasonal competition submissions into a fullscreen preview canvas, or compresses them into a secure spreadsheet document for local storage."
    },
    "Moderator Dashboard": {
      "Add New Story": "Input field and upload button to immediately push a new story to the public Reviewer panel.",
      "Delete Story": "A dropdown selector and danger button to permanently remove a story and its associated data from the live database.",
      "Submissions Ledger": "A real-time data table displaying all published dates and story names. Clicking a reviewer's name opens a detailed view of their specific rating and guesses.",
      "Daily Updates (Official Heading)": "Input field to officially log the author's real heading for the daily entry.",
      "Daily Updates (Title Winners)": "Dropdown pairs to match an exceptional suggested title with the specific reviewer who suggested it.",
      "Daily Updates (Author Guesses)": "Dropdown and chip-generator to officially mark which reviewers successfully guessed the author's identity.",
      "Save Notes": "Commits winning tags, selected titles, and official headings securely onto the targeted database reference."
    }
  },
  "developer": {
    "Developer Options": {
      "Version History": "Opens a dedicated canvas showing the ledger of previous Git builds, timestamps, and compiled release notes.",
      "Publish Update Info": "A detection module that flags when a new Git build is deployed, allowing the dev to write release notes and push the new version tag globally.",
      "Exclusive Mode (System Pause)": "A master switch that freezes standard reviewer voting forms and administrative actions entirely to safely carry out backend updates.",
      "Season Reset (Emergency)": "A high-level danger button that restores baseline identity names, clears current season subjects, and reverts the platform to a blank Jan00 state.",
      "Platform Feedback Canvas": "An interactive data matrix compiling all user-submitted feedback. Includes tools to read individual entries, append developer notes, and update statuses.",
      "Export Feedback": "Downloads the entire raw feedback database into an Excel file for offline tracking and project management."
    }
  }
}
